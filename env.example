# AutoClip EnvironmentENConfigEN
# EN .env ENConfig

# ENConfig
DATABASE_URL=sqlite:///./data/autoclip.db

# RedisConfig
REDIS_URL=redis://localhost:6379/0

# APIConfig
# ENConfigEN；Docker / ScriptENEnvironmentEN。
# LLM_PROVIDER: dashscope | openai | gemini | siliconflow（settings.json EN）
LLM_PROVIDER=dashscope
API_DASHSCOPE_API_KEY=your_dashscope_api_key_here
# API_OPENAI_API_KEY=
# API_GEMINI_API_KEY=
# API_SILICONFLOW_API_KEY=
# OpenAI EN（LLM_PROVIDER=openai EN，EN OpenAI EN）。
# EN: https://open.bigmodel.cn/api/paas/v4   DeepSeek: https://api.deepseek.com/v1
# Ollama: http://localhost:11434/v1（Docker EN http://host.docker.internal:11434/v1）
# OPENAI_BASE_URL=
# EN（alibabacloud.com EN Key）：EN；EN。
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
API_MODEL_NAME=qwen-plus
API_MAX_TOKENS=4096
API_TIMEOUT=30

# ProcessingConfig
PROCESSING_CHUNK_SIZE=5000
PROCESSING_MIN_SCORE_THRESHOLD=0.7
PROCESSING_MAX_CLIPS_PER_COLLECTION=5
PROCESSING_MAX_RETRIES=3

# ENConfig（EN，SystemENAutoEN）
# PATH_PROJECT_ROOT=
# PATH_DATA_DIR=
# PATH_UPLOADS_DIR=
# PATH_TEMP_DIR=
# PATH_OUTPUT_DIR=

# YouTube Download（EN）
# EN，EN；ENPleaseEN 429。EN zh-Hans,zh,en
# AUTOCLIP_YT_SUBTITLE_LANGS=zh-Hans,zh,en
# EN player client（android/ios/tv），EN client EN
# AUTOCLIP_YT_CLIENT=

# ENConfig
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=backend.log

# EnvironmentConfig
ENVIRONMENT=development
DEBUG=true 