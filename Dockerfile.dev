# AutoClip ENEnvironment Dockerfile
FROM python:3.11-slim

# ENEnvironmentEN
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app

WORKDIR /app

# InstallSystemDependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    ffmpeg \
    git \
    && rm -rf /var/lib/apt/lists/*

# InstallNode.js
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs

# ENPythonDependenciesEN
COPY requirements.txt ./

# ENEnvironmentENInstallPythonDependencies
RUN python3 -m venv venv
RUN . venv/bin/activate && pip install --upgrade pip
RUN . venv/bin/activate && pip install -r requirements.txt

# ENDependenciesEN
COPY frontend/package*.json ./frontend/

# InstallENDependencies
RUN cd frontend && npm install && npm run build

# ENProjectEN
COPY . .

# ENEnvironmentStartScript
COPY docker-dev-entrypoint.sh ./

# EN
RUN mkdir -p data/projects data/uploads data/temp data/output logs

# EN
RUN chmod +x *.sh
RUN chmod +x docker-dev-entrypoint.sh

# EN
EXPOSE 8000 3000

# StartEN
CMD ["./docker-dev-entrypoint.sh"]
